@using AspNetCoreMultiApp.Web.DTO
@model List<ProductDTO>

<h1>PRODUCTS</h1>
<table>
	<thead>
		<tr>
			<th>ID</th>
			<th>Name</th>
			<th>Price</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var product in Model)
		{
			<tr>
				<td>@product.Id</td>
				<td>@product.Name</td>
				<td>@product.Price</td>
			</tr>
		})
	</tbody>
</table>